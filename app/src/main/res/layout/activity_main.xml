<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <net.skyscanner.backpack.text.BpkText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eyebrow"
            android:textColor="@color/sky_blue"
            android:textSize="12sp" />

        <net.skyscanner.backpack.text.BpkText
            style="@style/bpkTextHeading1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/screen_title"
            android:textColor="@color/sky_navy" />

        <net.skyscanner.backpack.text.BpkText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="@string/sample_note"
            android:textColor="@color/sky_muted"
            android:textSize="14sp" />

        <net.skyscanner.backpack.card.BpkCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cornerStyle="large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/flight_label"
                    android:textColor="@color/sky_blue"
                    android:textSize="12sp" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/bpkTextHeading1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/flight_number"
                    android:textColor="@color/sky_navy" />

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/flight_route"
                    android:textColor="@color/sky_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </net.skyscanner.backpack.card.BpkCardView>

        <net.skyscanner.backpack.card.BpkCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cornerStyle="large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/departure_label"
                    android:textColor="@color/sky_blue"
                    android:textSize="12sp" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/bpkTextHeading1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/departure_code"
                    android:textColor="@color/sky_navy" />

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/departure_airport"
                    android:textColor="@color/sky_muted"
                    android:textSize="14sp" />

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/departure_time"
                    android:textColor="@color/sky_navy"
                    android:textSize="22sp" />

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/time_label"
                    android:textColor="@color/sky_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </net.skyscanner.backpack.card.BpkCardView>

        <net.skyscanner.backpack.card.BpkCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cornerStyle="large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/arrival_label"
                    android:textColor="@color/sky_blue"
                    android:textSize="12sp" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/bpkTextHeading1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/arrival_code"
                    android:textColor="@color/sky_navy" />

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/arrival_airport"
                    android:textColor="@color/sky_muted"
                    android:textSize="14sp" />

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/arrival_time"
                    android:textColor="@color/sky_navy"
                    android:textSize="22sp" />

                <net.skyscanner.backpack.text.BpkText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/time_label"
                    android:textColor="@color/sky_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </net.skyscanner.backpack.card.BpkCardView>
    </LinearLayout>
</ScrollView>

